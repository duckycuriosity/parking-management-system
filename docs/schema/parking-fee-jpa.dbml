// Phạm vi sau V56. Các bảng ngữ cảnh chỉ vẽ cột liên quan, không thay thế toàn schema.
Project parking_fee_jpa {
  database_type: 'PostgreSQL'
  Note: '''
    fee_calculation giữ snapshot bất biến, parking_fee_payment dùng payment hiện có.
    receipt JSON ghi tiền thực nhận và review; transaction_key chỉ bảo vệ identity toàn cục.
    Java/JPA sở hữu quy tắc, không có trigger tài chính mới. Không dùng receipt thuê bao cho phí phiên.
  '''
}

Table parking_session {
  id bigint [pk, increment]
  vehicle_id bigint
  parking_lot_id bigint
  entry_time timestamp [note: 'LocalDateTime legacy; cấu hình zone rõ ràng trước khi đổi sang instant.']
  exit_time timestamp
  Note: 'Chỉ phần ngữ cảnh. Chốt calculation không tự đổi lifecycle phiên hoặc mở barrier.'
}

Table fee_policy {
  id integer [pk, increment, note: 'V53 đổi BIGSERIAL V52 về INTEGER, khớp FeePolicyEntity.']
  parking_lot_id bigint
  vehicle_type varchar(20)
  version_no integer
  effective_from timestamptz
  effective_to timestamptz
  calculation_method varchar(30)
  pricing_rules jsonb [note: 'Giữ trong DB, không đọc/validate/sử dụng cho thuật toán.']
  Note: 'Chỉ phần ngữ cảnh V52/V53; giá/khung đầy đủ nằm trong schema thật và snapshot fee_detail.'
}

Table payment {
  id bigint [pk, increment]
  invoice_no varchar(100) [unique]
  amount numeric(18,2)
  currency varchar(10)
  status varchar(20)
  callback_type varchar [note: 'SESSION cho phí phiên; TICKET/SUBSCRIPTION giữ vai trò cũ.']
  callback_context jsonb [note: 'SESSION scoped chứa calculationId và parkingFeePaymentId. Đây không phải FK DB.']
  paid_at timestamp [note: 'Phạm vi phí mới lưu UTC; receipt giữ instant đáng tin cậy.']
  Note: 'Intent dùng lại, chỉ vẽ cột liên quan. Không thay payment thành mô hình cha-con.'
}

Table fee_calculation {
  id bigint [pk, increment]
  session_id bigint [not null, note: 'V56 chỉnh UUID V52 sang BIGINT nếu bảng trống; dữ liệu có sẵn cần mapping được duyệt.']
  fee_policy_id integer [note: 'Chỉ điền nếu có đúng một allocation; đa allocation xem snapshot, không dùng FK đơn này để dựng lịch sử.']
  charge_context varchar(30) [not null]
  calculated_at timestamptz [not null]
  calculation_until timestamptz [not null, note: 'Cutoff backend của bản tính, không phải thời gian được ra.']
  valid_until timestamptz [note: 'Hạn thanh toán cung cấp rõ; NULL legacy không payable. Không mặc định TTL.']
  engine_revision varchar(50) [not null]
  input_fingerprint varchar(64) [not null, note: 'SHA256 canonical JSON snapshot.']
  subtotal_vnd bigint [not null]
  rounding_adjustment_vnd bigint [not null]
  total_vnd bigint [not null, note: 'Làm tròn lên 1000 một lần; số nguyên chính xác.']
  fee_detail jsonb [not null, note: 'Giá/khung/lịch/coverage/allocations/quy ước/fee lines thực dùng, không chỉ ID.']
  status varchar(20) [not null, default: 'QUOTED', note: 'QUOTED → SUPERSEDED hoặc SETTLED; snapshot và tiền không sửa.']
  settled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (session_id, created_at) [name: 'idx_fee_calc_session_created']
    fee_policy_id [name: 'idx_fee_calc_policy_id']
  }
}

Table parking_fee_payment {
  id bigint [pk, increment]
  calculation_id bigint [not null, note: 'V56 chỉnh INTEGER sang BIGINT, FK bản tính gắn invoice.']
  payment_id bigint [unique, note: 'FK intent hiện có; legacy NULL không tự tạo mapping.']
  request_key varchar(100) [not null, unique, note: 'Replay cùng nội dung trả attempt cũ; khác bản tính/tiền trả conflict.']
  amount_vnd bigint [not null, note: 'Tiền yêu cầu backend; tiền thực nhận nằm trong receipt observation.']
  currency varchar(3) [not null, default: 'VND']
  status varchar(20) [not null, default: 'PENDING']
  application_status varchar(30) [not null, default: 'PENDING', note: 'PENDING/APPLIED/REVIEW_REQUIRED.']
  application_reason varchar(100)
  payment_source varchar(50)
  payment_reference varchar(255) [note: 'Binding giao dịch đầu; chuyển thêm không ghi đè.']
  requested_at timestamptz [not null]
  confirmed_at timestamptz
  receipt jsonb [note: 'Array append-only các giao dịch được xác minh, bao gồm chuyển thêm/tiền sai cần review.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    calculation_id [name: 'idx_fee_payment_calculation_id']
    (payment_source, payment_reference) [name: 'idx_fee_payment_source_ref']
  }
  Note: 'Chốt attempt/payment/calculation nguyên tử trong DB; event chỉ afterCommit, không có outbox mới.'
}

Table parking_fee_transaction_key {
  source varchar(50) [not null]
  reference varchar(255) [not null]
  attempt_id bigint [not null]
  identity_fingerprint varchar(64) [not null]
  created_at timestamptz [not null]
  indexes {
    (source, reference) [pk]
    attempt_id [name: 'idx_parking_fee_transaction_attempt']
  }
  Note: 'Registry identity tối thiểu, không ledger. PK chống cùng giao dịch áp vào hai intent cạnh tranh; receipt JSON giữ bằng chứng tiền.'
}

// Ref vật lý; liên kết trong callback_context/fee_detail không phải FK.
Ref fk_fee_calculation_session: fee_calculation.session_id > parking_session.id
Ref fk_fee_calculation_policy: fee_calculation.fee_policy_id > fee_policy.id
Ref fk_parking_fee_payment_calculation: parking_fee_payment.calculation_id > fee_calculation.id
Ref fk_parking_fee_payment_payment: parking_fee_payment.payment_id > payment.id
Ref: parking_fee_transaction_key.attempt_id > parking_fee_payment.id
